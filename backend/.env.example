# Server Configuration
PORT=8081

# Database Configuration (PostgreSQL/Supabase Connection String)
# If using Supabase Connection Pooler (PgBouncer) on port 6543, you MUST append:
# "?sslmode=require&default_query_exec_mode=exec&statement_cache_capacity=0"
DATABASE_URL=postgresql://user:password@host:6543/dbname?sslmode=require&default_query_exec_mode=exec&statement_cache_capacity=0

# Authentication
JWT_SECRET=your_super_secret_jwt_key_here

# Email SMTP Settings (For OTP verification / notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_SENDER=Lapor Kos <your_email@gmail.com>

# Frontend URL (For CORS protection)
FRONTEND_URL=http://localhost:3000

# Google Gemini API Key (For AI-based complaint categorization and priority mapping)
GEMINI_API_KEY=your_gemini_api_key_here

# WhatsApp Gateway (Fonnte API for sending automated chat notifications)
WHATSAPP_API_URL=https://api.fonnte.com/send
WHATSAPP_API_TOKEN=your_fonnte_token_here

# Supabase Storage Configuration (For file uploads - user profile photos, complaints)
SUPABASE_URL=https://your_project_ref.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here
SUPABASE_BUCKET=uploads
