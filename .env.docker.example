# Docker Compose local defaults.
# Copy this file to .env if you want to override Compose values.

# The browser-facing backend URL baked into the Next.js frontend build.
NEXT_PUBLIC_API_URL=http://localhost:8081

# Origins allowed by the Go backend CORS middleware.
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
